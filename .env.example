# Copy to .env and fill in local values. Never commit the real .env file.

SECRET_KEY=change-me-to-a-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase (or any PostgreSQL) connection string. Supabase's dashboard gives you
# this directly under Project Settings > Database > Connection string — paste it
# as-is (Session pooler recommended; include ?sslmode=require).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
