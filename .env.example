# Copy to .env and fill in local values. Never commit the real .env file.

SECRET_KEY=change-me-to-a-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon (or any PostgreSQL) connection string. Neon's dashboard gives you this
# directly, including ?sslmode=require — paste it as-is.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
